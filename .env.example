# === Meta Model API (required for live) ===
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_OBSERVER_MODEL=muse-spark-1.3
META_PI_MODEL=muse-wonder-1.0
META_IMAGE_MODEL=muse-image-1.0
META_SAM_MODEL=sam-3.1
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_USE_CONTRIBUTOR=false

# === Meta partners ===
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
BASETEN_API_KEY=
FIREWORKS_API_KEY=
GLIMMER_PROVIDER=stub
# modal | baseten | fireworks | stub — see docs/GLIMMER_SWARM.md (P2.2)
# GLIMMER_BASETEN_URL=
# GLIMMER_FIREWORKS_URL=

# === AWS (priority #2) ===
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Local compose: postgresql://hypatia:hypatia@127.0.0.1:5432/hypatia
# Supabase: use Session pooler from dashboard (not direct db.* if DNS/IPv6 fails), e.g.
# postgresql://postgres.<project-ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# === App ===
FIXTURE_MODE=true
# When FIXTURE_MODE=false: set FIXTURE_RECORD=true to write live Observer/SAM captures to data/fixtures/
FIXTURE_RECORD=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000
API_ORIGIN=http://127.0.0.1:8000
